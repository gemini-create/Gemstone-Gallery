<!DOCTYPE html>
<html lang="en">
<head>
  <title>Gemstone Gallery-Cart</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  
  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<style>
	html,body{
		height:100%;
		padding:0;
		margin:0;
		}

		body{
		display:flex;
		flex-direction:column;
		}

		main{
		flex:1;
		padding:20px;
		}

		nav{
		margin:0 0 2px 0;
		}

		.navbar ul{
		padding:10px}

		.nav-link{
			position:relative;
		}

		.nav-link::after{
			content:"";
			position:absolute;
			bottom:0;
			left:0;
			width: 0%;
			height:2px;
			background-color:white;
            transition:width 0.3s;
		}

		.nav-link:hover::after{
			width:100%;
		}

		.dropdown-item{
			position:relative;
		}

		.dropdown-item::after{
			content:"";
			position:absolute;
			bottom:0;
			left:0;
			width: 0%;
			height:2px;
			background-color:black;
            transition:width 0.3s;
		}
		.dropdown-item:hover::after{
			width:100%;
		}

		footer{
		background-color:#212529;
		color:white;
		margin:2px 0 2px 0;
		padding:20px 20px;
		display:flex;
		justify-content: space-between;
		}

		footer a{
		color:white;
		font-size:1.2rem;
		padding:2px;
		}

		footer .social a:hover {
		color: #0d6efd; /* Bootstrap primary blue */
		}
		
</style>
<body>
	<nav class="navbar navbar-expand-sm bg-dark navbar-dark">
		<div class="container-fluid">
			<a class="navbar-brand" href="#"><i class="fa-regular fa-gem"></i>Gemstone Gallery </a>

			<ul class="navbar-nav mx-auto ">
				<li class="nav-item"><a class="nav-link active" href="/">Home</a></li>
				<li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
				<li class="nav-item"><a class="nav-link" href="/cart">Cart</a></li>
				<li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
			</ul>

			<div class="dropdown">
				<a class="navbar-brand " data-bs-toggle="dropdown"><i class="fa-solid fa-user"></i></a>
				
				<ul class="dropdown-menu dropdown-menu-end">
                  <% if (!user) { %>
                    <li><a class="dropdown-item" href="/signup">Sign Up</a></li>
                    <li><a class="dropdown-item" href="/login">Log In</a></li>

                  <% } else { %>
                    <li><a class="dropdown-item" href="/logout">Logout</a></li> 	
                  <% } %>
				</ul>
          	</div>
		</div>
	</nav>

	<main class="container mt-4">
		<div class="container">
  			<% if (items.length === 0) { %>
                <p class="text-center">No items in your Cart.</p>

            <% } else { %>
   		<table class="table table-bordered table-striped">
        	<thead class="table-dark">
                    <tr>
						<th>Image</th>
                        <th>Product</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>

        	<tbody>
			<% let grandTotal = 0; %>
            <% items.forEach(item => { %>
            	<tr>
					<td><img src="<%= item.image %>" width="60" /></td>
                    <td><%= item.name %></td>
					<td><%= item.description %></td>
                    <td>Rs <%= item.price.toFixed(2) %></td>
                    <td><%= item.quantity %></td>
                    <td>Rs <%= (item.price * item.quantity).toFixed(2) %></td>
                    <td>
                        <form action="/cart/remove" method="POST">
							<input type="hidden" name="cartid" value="<%=item.cartid%>">
                            <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                        </form>
                    </td>
             	</tr>
				<% grandTotal =grandTotal + parseFloat(item.price) * item.quantity; %>
             <% }) %>
         	</tbody>
   		</table>

		<h4 >Grand Total: Rs. <%= grandTotal.toFixed(2) %></h4>
		<a href="/checkout" class="btn btn-success mt-3">Proceed to Checkout</a>
        <% } %>
		</div>
	</main>

	<footer>
		<div class="intro">
			<h5>Gemstone Gallery</h5>
			<p class="text-white">© 2025 Gemstone Gallery. All rights reserved.</p>
		</div>

		<div class="social">
			<p class="h5 mx-auto">Follow Us</p>
			<a href="https://www.facebook.com/"><i class="fa-brands fa-facebook"></i></a>
			<a href="https://www.instagram.com/"><i class="fa-brands fa-instagram"></i></a>
			<a href="https://www.youtube.com/"><i class="fa-brands fa-youtube"></i></a>
			<a href="https://www.whatsapp.com/"><i class="fa-brands fa-whatsapp"></i></a>
		</div>
	</footer>
</body>
</html>
