<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Gemstone Gallery-CheckOut</title>

    <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  
  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
      
        .navbar-nav{
            margin:auto;
            }
        .nav-link{
            position:relative;
            }
        .nav-link::after{
            content:"";
            position:absolute;
            left:0;
            bottom:0;
            width:0%;
            height:2px;
            color:white;
            background-color:white;
            transition:width 0.3s;
            }
            .nav-link:hover::after{
                width:100%;
            }
            .dropdown-item{
                position:relative;
            }
            .dropdown-item::after{
                content:"";
                position:absolute;
                left:0;
                bottom:0;
                width:0%;
                height:2px;
                background-color:black;
                transition:width 0.2s;
                }
            .dropdown-item:hover::after{
                width:100%;
                }
            
            footer {
                background-color: #212529;
                color: white;
                margin: 2px 0 2px 0;
                padding: 20px 20px;
                display: flex;
                justify-content: space-between;
                
                }

                footer a{
                color:white;
                font-size:1.2rem;
                padding:2px;
                }

                footer .social a:hover {
                  color: #0d6efd; /* Bootstrap primary blue */
                }
                body,html{
                   height:100%;
                   margin:0;
                   padding:0;
                }
                 body {
                   background-color: #F5F5F5;
                   display: flex;
                   flex-direction: column;
                }
                 main{
                     flex:1;
                 }

                .form {
                    margin: auto;
                    width: 30%;
                    height: auto;
                    background-color:#ffffff;
                   
                }      
    </style>
</head>
<body>

    <% if (orderMessage) { %>
		<div class="toast align-items-center text-bg-success border-0 show position-fixed bottom-0 end-0 p-3 z-index:11" role="alert">
      		<div class="d-flex">
       			 <div class="toast-body">
         			 <%= orderMessage %>
        		</div>

        		<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      		</div>
   		 </div>
	<% } %>

    <nav class="navbar navbar-expand-sm bg-dark navbar-dark mb-2">

    <div class="container-fluid">
        <a class="navbar-brand" href="#">
     	 <i class="fa-regular fa-gem"></i>
      		Gemstone Gallery
   	 </a>

        <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link " href="/shop">Shop<a></li>
            <li class=" nav-item"><a class="nav-link" href="/cart">Cart</a></li>
            <li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
        </ul>

        <div class="dropdown">
            <a class="navbar-brand " data-bs-toggle="dropdown"><i class="fa-solid fa-user"></i></a>

            <ul class="dropdown-menu dropdown-menu-end">
		<% if (!user) { %>
			<li><a class="dropdown-item" href="/signup">Sign Up</a></li>
      		<li><a class="dropdown-item" href="/login">Log In</a></li>
		<% } else { %>
			<li><a class="dropdown-item" href="/logout">Logout</a></li> 	
		<% } %>

    </ul>
        </div>
    </div>
    </nav>

 <main>
    <div class="form  rounded-4 px-3 mt-3 shadow ">
       <form action="/checkout" method="post" autocomplete="on" >

        <!--embedding js in html with ejs tags-->
            <% if (errors && errors.length){ %>
                    <% errors.forEach(error => { %>
                        <p class="alert alert-danger py-1 mt-3"> <%= error %></p>
                 <%   })}; %>


    <fieldset>
        <h3 style="text-align:center" class="my-3">Check Out</h3>
        <h5 class="text-lg font-bold my-4">Billing Information</h5>

        <label for="fullname" class="form-label">Fullname</label>
        <input type="text" id="fullname" name="fullname"  class="form-control" placeholder="e.g. Sajid Ali" required/>

        <label for="email" class="form-label">Email</label>
        <input type="email" id="email" name="email"  class="form-control" placeholder="e.g. sajid@gmail.com" required/>

        <label for="phone" class="form-label">Phone</label>
        <input type="text" id="phone" name="phone" class="form-control" placeholder="e.g. 0300-1234567" required/>

        <label for="address" class="form-label">Address</label>
        <textarea id="address" name="address" rows="3" class="form-control" required placeholder="e.g. Street #10, G-11, Islamabad" required></textarea>

        <label for="city" class="form-label">City</label>
        <input type="text" id="city" name="city"  class="form-control" placeholder="e.g. Islamabad" required />

        <label for="zip" class="form-label">Postal Code</label>
        <input type="text" id="zip" name="zip"  class="form-control" placeholder="e.g. 44000" required/>

        <h5 class="text-lg font-bold text-gray-800 my-4">Payment Information</h5>
        <p>
            <i class="fa-solid fa-truck-dollar" style="color: green; font-size: 1.5rem;"></i>
            Cash on Delivery Available
        </p>

        <button type="submit" class="btn btn-outline-success my-3 d-block mx-auto">Check Out</button>
    </fieldset>
</form>

    </div>
</main>
    <footer class="bg-dark text-white mt-2">
        <div class="rights">
        <h5><b>&copy;Gemstone Gallery</b></h5>
        <p>2025 Gemstone Gallery.All rights reserved.</p>
        </div>
        
        <div class="social">
             <p class="h5 mx-auto">Follow Us</p>
	            <a href="https://www.facebook.com/"><i class="fa-brands fa-facebook"></i></a>
	            <a href="https://www.instagram.com/"><i class="fa-brands fa-instagram"></i></a>
	            <a href="https://www.youtube.com/"><i class="fa-brands fa-youtube"></i></a>
	            <a href="https://www.whatsapp.com/"><i class="fa-brands fa-whatsapp"></i></a>
	     </div>
    </footer> 
     
    
</body>
</html>


    
  
