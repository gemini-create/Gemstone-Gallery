<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width , initial scale=1">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
            
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
       html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 1rem;
            background-color: #F5F5F5;
            
        }
             body{
                 background-image:url("gem1.jpg");
                 background-size:cover;
                 background-position:right;
                 background-repeat: no-repeat;
                
             }

        .sidebar {
            background-color: #1E2A38;
            height: 100vh;
            width: 250px;
            padding: 20px;
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.2);
        }

        .sidebar h2 {
            font-size: 1.4rem;
            text-align: center;
            margin-bottom: 30px;
        }

        .sidebar ul {
            list-style: none;
            padding: 0;
        }

        .sidebar ul li {
            margin-bottom: 10px;
        }

        .sidebar ul li span {
            font-size: 0.9rem;
            font-weight: bold;
            text-transform: uppercase;
            color: #ccc;
            margin-top: 10px;
            display: block;
        }

        .sidebar a {
            color: #fff;
            text-decoration: none;
            display: block;
            padding: 8px 15px;
            border-radius: 5px;
            transition: 0.3s;
        }

        .sidebar a:hover {
            background-color: #0d6efd;
        }

        main {
            margin-left: 250px;
            padding: 30px;
        }
        .main-content{
             background-color: rgba(255, 255, 255, 0.3);
             backdrop-filter: blur(10px);
             width:40%;
             text-align:center;
             margin:auto;
             border-radius: 8px;
             position: absolute;
            top: 40%;
            left: 60%;
            transform: translate(-60%, -40%);
                    
        }

        @media (max-width: 768px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            main {
                margin-left: 0;
                
            }
        }
        .store-logo {
                width: 120px;
                height: 120px;
                border-radius: 50%;
                object-fit: cover;
                border: 3px solid white;
                box-shadow: 0 0 8px rgba(0, 0, 0, 0.2);
            }
       </style>
</head>

<body>
    <div class="sidebar navbar ">
        <div class="text-center mb-2">
            <h2>Hey! <%=user.username%></h2>
            <img src="gem1.jpg" alt="Store Logo" class="store-logo " />
        </div>
       
        <ul class="mainList">
            <li><a  href="/admin"><i class="fa-solid fa-chart-line me-2"></i>Dashboard</a></li> 
            <li><span>Products</span></li>

                <ul class="innerList">
                    <li ><a href="/add"><i class="fa-solid fa-plus px-3"></i>Add Products</a></li>
                    <li ><a href="view"><i class="fa-solid fa-boxes-stacked px-3"></i>View Products</a></li>
                    <li ><a href="/view"><i class="fa-solid fa-pen-to-square px-3"></i>Update Products</a></li>
                    <li ><a href="/view"><i class="fa-solid fa-trash px-3"></i>Delete Products</a></li>
               </ul>

            <li><span>Customers</span></li>
                <ul class="innerList">
                    <li ><a href="viewCustomers" ><i class="fa-solid fa-boxes-stacked px-3"></i>View Customers</a></li>
                </ul>

            <li><span>Orders</span></li>
                <ul class="innerList">
                    <li ><a href="viewOrders" ><i class="fa-solid fa-boxes-stacked px-3"></i>View Orders</a></li>
                </ul>


            <li><span>Settings</span></li>
                <ul class="innerList">
                        <% if (!user) { %>
                            <li><a href="/login"><i class="fa-solid fa-right-to-bracket me-2"></i>>Log In</a></li>
                            <li><a  href="/"><i class="fa-solid fa-right-to-bracket me-2"></i>Back to Home</a></li> 
                        <% } else { %>
                            <li><a  href="/logout"> <i class="fa-solid fa-right-to-bracket me-2"></i>Logout</a></li> 
                            <li><a  href="/"><i class="fa-solid fa-right-to-bracket me-2"></i>Back to Home</a></li> 	
                        <% } %>
                </ul>
        </ul>
    </div>
    <div class="main-content">
        <h1 class="text-center text-white pt-3">Welcome to the Admin Panel</h1>
        <main>
            <div class="container">
                <p id="dateTime" class="text-center text-white"></p>
            </div>
        </main>
    </body>
    <script>
        const now = new Date();
        document.getElementById("dateTime").innerText = "Date: " + now.toLocaleDateString() + " | Time: " + now.toLocaleTimeString();
  </script>
</html>