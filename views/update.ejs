<!DOCTYPE html>
<html>
    <head>
        <title>Update Products-Admin Dashboard</title>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width , initial scale=1">

        <!-- Font Awesome -->
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
            
        <!-- Bootstrap -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        <style>
        html,body{
        margin:0;
        padding:0;
        height:100%;
        }
        
        body{
        display:flex;
        background-color: #F5F5F5;
        }
        
        .main-content{
        flex:1;
        padding: 30px;
    }
        .sidebar{
            height:100vh;
            width:250px;
            padding: 2px;
            color:white;
        }
        .sidebar h2 {
            text-align: center;
            padding:4px;
        }
        .sidebar ul {
            list-style: none;
            padding: 0;
        }

        .sidebar ul li {
            padding: 10px;
        }

        .sidebar ul li a {
            color: #fff;
            text-decoration: none;
            display: block;
        }
        .innerList{
            margin-left: 20px;
        }
        
        .stats{
           
            display:flex;
            gap: 10px;
            justify-content: center;
            
        }
        </style>
    </head>

    <body>
    <div class="sidebar navbar bg-dark navbar-dark ">
        <h2>Hey! <%=user.username%></h2>
       
        <ul class="mainList">
            <li><a  href="/admin" class="btn btn-secondary">Dashboard</a></li> 
            <li >Products</li>

                <ul class="innerList">
                    <li ><a href="/add" class="btn btn-secondary"><i class="fa-solid fa-plus px-3"></i>Add Products</a></li>
                    <li ><a href="view" class="btn btn-secondary"  ><i class="fa-solid fa-boxes-stacked px-3"></i>View Products</a></li>
                    <li ><a href="/view" class="btn btn-secondary" ><i class="fa-solid fa-pen-to-square px-3"></i>Update Products</a></li>
                    <li ><a href="/view" class="btn btn-secondary"><i class="fa-solid fa-trash px-3"></i>Delete Products</a></li>
               </ul>

            <li>Customers</li>
                <ul class="innerList">
                    <li ><a href="viewCustomers" class="btn btn-secondary"  ><i class="fa-solid fa-boxes-stacked px-3"></i>View Customers</a></li>
                </ul>

            <li>Orders</li>
                <ul class="innerList">
                    <li ><a href="viewOrders" class="btn btn-secondary"  ><i class="fa-solid fa-boxes-stacked px-3"></i>View Orders</a></li>
                </ul>

            <li >Settings</li>
                <ul class="innerList">
                        <% if (!user) { %>
                            <li><a href="/login" class="btn btn-secondary">Log In</a></li>
                            <li><a  href="/" class="btn btn-secondary">Back to Home</a></li> 
                        <% } else { %>
                            <li><a  href="/logout" class="btn btn-secondary">Logout</a></li> 
                            <li><a  href="/" class="btn btn-secondary">Back to Home</a></li> 	
                        <% } %>
                </ul>
        </ul>
    </div>
<div class="main-content container mt-4">
  <main>
        <h2>Update Product</h2>

        <form method="POST" action="/update/<%= product.id %>">
            
            <label class="form-label">Product Name</label>
            <input type="text" name="productname" value="<%= product.name %>" class="form-control" required>

            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3"><%= product.description %></textarea>
           
            <label class="form-label">Price</label>
            <input type="number" name="price" value="<%= product.price %>" class="form-control" required step="100">
            
            <label class="form-label">Current Image</label><br>
                <% if (product.image) { %>
            <img src="/<%= product.image %>" width="100">
                <% } %>
            <br>
            <label class="form-label">Change Image</label>
            <input type="file" name="image" accept="image/*" class="form-control">

            <button type="submit" class="btn btn-success mt-3">Update Product</button>
            <a href="/view" class="btn btn-secondary mt-3">Cancel</a>
        </form>
        </div>
  </main>
</div>
</body>
</html>