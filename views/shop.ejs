<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gemstone Gallery - Shop</title>
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<style>
        body {
          background-color:#F5F5F5;
          height:100%;
          }

        main{
            flex:1;
            }

        .navbar-nav{
            margin:auto;
        }

        .nav-link{
            position:relative;
        }

        .nav-link::after{
            content:"";
            position:absolute;
            left:0;
            bottom:0;
            width:0%;
            height:2px;
            color:white;
            background-color:white;
            transition:width 0.3s;
        }
        .nav-link:hover::after{
            width:100%;
        }

        .dropdown-item{
            position:relative;
        }

        .dropdown-item::after{
            content:"";
            position:absolute;
            left:0;
            bottom:0;
            width:0%;
            height:2px;
            background-color:black;
            transition:width 0.2s;
        }

        .dropdown-item:hover::after{
            width:100%;
        }
            
        footer {
            background-color: #212529;
            color: white;
            margin: 2px 0 2px 0;
            padding: 20px 20px;
            display: flex;
            justify-content: space-between;
        }
       
       .cards-container{
           display:flex;
           flex-wrap:wrap;
           justify-content:space-evenly;   
       }
        .card{
           width:23%;
           box-shadow:4px 4px 6px lightgray;
           margin:5px;
           transition: transform 0.3s, box-shadow 0.3s;
               }

        .card img {
            width: 100%;
            height: 300px;
            border-radius: 5px;
            object-fit: cover;
           }

        .card-body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex-grow: 1;
          }
          .card:hover {
              transform: translateY(-7px);
              box-shadow: 6px 6px 12px rgba(0, 0, 0, 0.15);
            }

          .btn-primary:hover {
              transform: scale(1.05);
              transition: transform 0.2s, background-color 0.2s;
            }

          #modalImage {
              max-height: 65vh; /* 80% of the viewport height */
              width: 100%;
              object-fit:contain;
            }
          .modal-content{
              background-color: rgba(255, 255, 255, 0.3);
              backdrop-filter: blur(10px);
              border: none;
            }

        footer a{
            color:white;
            font-size:1.2rem;
            padding:2px;
              }

        footer .social a:hover {
            color: #0d6efd; /* Bootstrap primary blue */
              }
    
  </style>
</head>

<body>
  
    <nav class="navbar navbar-expand-sm text-bg-dark navbar-dark mb-2">
      <div class="container-fluid">
          <a class="navbar-brand" href="#"><i class="fa-regular fa-gem"></i>Gemstone Gallery</a>
        
          <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link " href="/shop">Shop</a></li>
            <li class=" nav-item"><a class="nav-link" href="/cart">Cart</a></li>
            <li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
          </ul>

          <div class="dropdown">
            <a class="navbar-brand " data-bs-toggle="dropdown"><i class="fa-solid fa-user"></i></a>

            <ul class="dropdown-menu dropdown-menu-end">
                  <% if (!user) { %>
                    <li><a class="dropdown-item" href="/signup">Sign Up</a></li>
                    <li><a class="dropdown-item" href="/login">Log In</a></li>

                  <% } else { %>
                    <li><a class="dropdown-item" href="/logout">Logout</a></li> 	
                  <% } %>
      
            </ul>
          </div>
      </div>
    </nav>

    <main class="container-fluid">
       <section class="cards-container">

          <% products.forEach(function(product) { %>
          
          <div class="card">
            <img 
                class="card-img-top"
                src="<%=product.image%>" 
                alt="A stunning ruby necklace with a gold chain"
                data-bs-toggle="modal" 
                data-bs-target="#imageModal"
                title="Click to view details"   
                onclick="showImageModal(
                        '<%= product.image %>',
                        '<%= product.name %>',
                        '<%= product.price %>',
                        '<%= product.description %>',
                        '<%= product.id %>'
                      )"
            />

            <div class="card-body">
              <h3 class="card-title text-center" ><%=product.name%></h3>
              <p class="text-success text-center" style="font-size: large;"><strong>Rs <%=product.price%></strong></p>
            </div>
          </div>  

         <% }) %>
      </section>
    </main>

    <div class="modal fade" id="imageModal" >
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0">
            
        <div class="d-flex justify-content-end pt-2 pe-3">
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="row">
              
            <div class="col-md-6">
              <img id="modalImage" src="" class="img-fluid rounded w-100" style="object-fit:contain; max-height:500px;" />
            </div>

            <div class="col-md-6 d-flex flex-column justify-content-center">
              <h4 id="modalProductName">Product Name</h4>
              <h5 class="text-success">Rs <span id="modalProductPrice">0000</span></h5>
              <p id="modalProductDesc">Short description</p>
              <p><strong>Delivery Time:</strong> 5 to 7 Days</p>
              <p><strong>Payment Mode:</strong> Cash on Delivery</p>
                  
              <form action="/cart/add" method="POST">
                <input type="hidden" name="productId" id="modalProductId">
                <button type="submit" class="btn btn-primary mt-3">Add to Cart</button>
              </form>
            </div>

          </div>
        </div>
       </div>
      </div>
    </div>

  <footer>
    <div class="intro">
      <h5>Gemstone Gallery</h5>
      <p class="text-white">© 2025 Gemstone Gallery. All rights reserved.</p>
    </div>

    <div class="social">
      <p class="h5 mx-auto">Follow Us</p>
      <a href="https://www.facebook.com/"><i class="fa-brands fa-facebook"></i></a>
      <a href="https://www.instagram.com/"><i class="fa-brands fa-instagram"></i></a>
      <a href="https://www.youtube.com/"><i class="fa-brands fa-youtube"></i></a>
      <a href="https://www.whatsapp.com/"><i class="fa-brands fa-whatsapp"></i></a>
    </div>
  </footer>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    const tooltipList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    tooltipList.forEach(el => new bootstrap.Tooltip(el));
  });
  function showImageModal(imageUrl, name, price, description, productId) {
    document.getElementById('modalImage').src = imageUrl;
    document.getElementById('modalProductName').innerText = name;
    document.getElementById('modalProductPrice').innerText = price;
    document.getElementById('modalProductDesc').innerText = description;
    document.getElementById('modalProductId').value = productId;
  }
</script>


</body>
</html>
