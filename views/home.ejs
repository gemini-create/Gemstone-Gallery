<!DOCTYPE html>
<html lang="en">
<head>
	<title>Gemstone Gallery-HOME</title>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	
	<!-- Font Awesome -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
	
	<!-- Bootstrap -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<style>

		html,body{
			height:100%;
			padding:0;
			margin:0;
		}

		body{
			display:flex;
			flex-direction:column;
		}

		main{
			flex:1;
		}

		.carousel-item img
		{
			display:block;
			object-fit:cover;
			height:650px;
			width:100%;
		}

		.carousel-caption {
			bottom: 40%;
			background-color: rgba(0, 0, 0, 0.5); /* semi-transparent black */
			color: white; 
			padding: 20px;
			border-radius: 10px;
			width:500px;
			margin:auto;
		}

		.carousel-caption h1 {
			font-size: 2rem;
			font-weight: bold;
		}

		.carousel-caption p {
			font-size: 1rem;
		}

		.navbar ul{
			padding:10px;
		}

		.nav-link{
			position:relative;
		}

		.nav-link::after{
			content:"";
			position:absolute;
			bottom:0;
			left:0;
			width: 0%;
			height:2px;
			background-color:white;
            transition:width 0.3s;
		}

		.nav-link:hover::after{
			width:100%;
		}

		.dropdown-item{
			position:relative;
		}

		.dropdown-item::after{
			content:"";
			position:absolute;
			bottom:0;
			left:0;
			width: 0%;
			height:2px;
			background-color:black;
            transition:width 0.3s;
		}

		.dropdown-item:hover::after{
			width:100%;
		}

		footer{
			background-color:#212529;
			color:white;
			padding:20px 20px;
			display:flex;
			justify-content: space-between;
		}

		footer a{
			color:white;
			font-size:1.2rem;
			padding:2px;
		}

		footer .social a:hover {
			color: #0d6efd; 
		}
	</style>
</head>

<body>
	<nav class="navbar navbar-expand-sm bg-dark navbar-dark">
		<div class="container-fluid">
			<a class="navbar-brand" href="#"><i class="fa-regular fa-gem"></i>Gemstone Gallery</a>

			<!-- Centered nav links -->
			<ul class="navbar-nav mx-auto "> <!-- navlinks center by mx -->
				<li class="nav-item"><a class="nav-link active" href="/">Home</a></li>
				<li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
				<li class="nav-item"><a class="nav-link" href="/cart">Cart</a></li>
				<li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
			</ul>
	
			<div class="dropdown">
				<a class="navbar-brand" href="#" data-bs-toggle="dropdown"><i class="fa-solid fa-user"></i></a>
				<ul class="dropdown-menu dropdown-menu-end">
					<% if (!user) { %>
						<li><a class="dropdown-item" href="/signup">Sign Up</a></li>
						<li><a class="dropdown-item" href="/login">Log In</a></li>
					<% } else { %>
						<li><a class="dropdown-item" href="/logout">Logout</a></li> 	
					<% } %>
				</ul>
			</div>
		</div>
	</nav>

	<main>
	
		<div class="carousel  slide" data-bs-ride="carousel" id="banner" data-bs-interval="2000" >
			<div class="carousel-indicators">
				<button type="button" data-bs-target="#banner" data-bs-slide-to="0" class="active"></button>
				<button type="button" data-bs-target="#banner" data-bs-slide-to="1"></button>
				<button type="button" data-bs-target="#banner" data-bs-slide-to="2"></button>
			</div>
		
			<div class="carousel-inner">
				<div class="carousel-item active">
					<img src="gem5.jpg" alt="1" >
					<div class="carousel-caption">
						<h1>Exquisite Gemstone Jewelry</h1>
						<p>Handcrafted with precision and passion</p>
						<a href="/shop" class="btn btn-primary btn-sm" onclick="gotoShop()">Shop Now</a>
					</div>
				</div>

				<div class="carousel-item">
					<img src="https://images.pexels.com/photos/265906/pexels-photo-265906.jpeg" alt="2" >
					<div class="carousel-caption">
						<h1>Exquisite Gemstone Jewelry</h1>
						<p>Handcrafted with precision and passion</p>
						<a href="/shop" class="btn btn-primary btn-sm" onclick="gotoShop()">Shop Now</a>
					</div>
				</div>

				<div class="carousel-item">
					<img src="gem7.jpg" alt="3">
					<div class="carousel-caption">
						<h1>Exquisite Gemstone Jewelry</h1>
						<p>Handcrafted with precision and passion</p>
						<a href="shop.html" class="btn btn-primary btn-sm" onclick="gotoShop()">Shop Now</a>
					</div>
				</div>
			</div>

			<button type="button" class="carousel-control-prev" data-bs-target="#banner" data-bs-slide="prev">
				<span class="carousel-control-prev-icon"></span>
			</button>

			<button type="button" class="carousel-control-next" data-bs-target="#banner" data-bs-slide="next">
				<span class="carousel-control-next-icon"></span>
			</button>
		</div>
	</main>

	<footer>
		<div class="intro">
			<h5>Gemstone Gallery</h5>
			<p class="text-white">© 2025 Gemstone Gallery. All rights reserved.</p>
		</div>

		<div class="social">
			<p class="h5 mx-auto">Follow Us</p>
			<a href="https://www.facebook.com/"><i class="fa-brands fa-facebook"></i></a>
			<a href="https://www.instagram.com/"><i class="fa-brands fa-instagram"></i></a>
			<a href="https://www.youtube.com/"><i class="fa-brands fa-youtube"></i></a>
			<a href="https://www.whatsapp.com/"><i class="fa-brands fa-whatsapp"></i></a>
		</div>
	</footer>	
</body>
</html>
